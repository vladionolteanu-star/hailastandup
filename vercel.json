{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/events.js": {
      "maxDuration": 60
    },
    "api/event.js": {
      "maxDuration": 20
    },
    "api/acasa.js": {
      "includeFiles": "{pagini/acasa.html,public/data/events.js,public/data/clipuri.js,public/data/artisti.js}"
    },
    "api/comediant.js": {
      "includeFiles": "{pagini/comediant.html,public/data/events.js,public/data/artisti.js,public/data/arhiva/*.js}"
    },
    "api/sitemap.js": {
      "includeFiles": "{public/data/events.js,public/data/artisti.js,public/data/arhiva/*.js}"
    }
  },
  "images": {
    "sizes": [
      240,
      320,
      420,
      560,
      720,
      900
    ],
    "qualities": [
      70,
      80
    ],
    "minimumCacheTTL": 604800,
    "formats": [
      "image/webp"
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "static3.iabilet.ro"
      },
      {
        "protocol": "https",
        "hostname": "imgcdn3.iabilet.ro"
      },
      {
        "protocol": "https",
        "hostname": "i.ytimg.com"
      }
    ]
  },
  "redirects": [
    {
      "source": "/:cale*",
      "has": [{ "type": "host", "value": "hailastandup.vercel.app" }],
      "destination": "https://www.hailastandup.ro/:cale*",
      "permanent": true
    },
    {
      "source": "/:cale*",
      "has": [{ "type": "host", "value": "hailastandup-vlad-star-s-projects.vercel.app" }],
      "destination": "https://www.hailastandup.ro/:cale*",
      "permanent": true
    },
    {
      "source": "/:cale*",
      "has": [{ "type": "host", "value": "hailastandup-git-main-vlad-star-s-projects.vercel.app" }],
      "destination": "https://www.hailastandup.ro/:cale*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/acasa"
    },
    {
      "source": "/comedianti/:slug",
      "destination": "/api/comediant?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
